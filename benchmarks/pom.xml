<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.vanguard</groupId>
        <artifactId>vanguard-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>vanguard-benchmarks</artifactId>
    <description>Standalone benchmark runner for measured performance values</description>

    <dependencies>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-simulator</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-tracking</artifactId>
        </dependency>
        <dependency>
            <groupId>com.vanguard</groupId>
            <artifactId>vanguard-spatial</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ejml</groupId>
            <artifactId>ejml-simple</artifactId>
            <version>0.43.1</version>
        </dependency>
        <dependency>
            <groupId>org.locationtech.jts</groupId>
            <artifactId>jts-core</artifactId>
            <version>1.19.0</version>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <mainClass>com.vanguard.benchmark.FullBenchmark</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
