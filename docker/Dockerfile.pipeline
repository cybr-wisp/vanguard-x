# ── Build ──────────────────────────────────────────────────────────
FROM eclipse-temurin:21-jdk-jammy AS builder
WORKDIR /build

COPY pom.xml .
COPY vanguard-simulator/pom.xml vanguard-simulator/
COPY vanguard-pipeline/pom.xml  vanguard-pipeline/
COPY proto/ proto/

RUN --mount=type=cache,target=/root/.m2 \
    mvn dependency:go-offline -B 2>/dev/null || true

COPY . .
RUN --mount=type=cache,target=/root/.m2 \
    mvn clean package -pl vanguard-pipeline -am -DskipTests -B

# ── Runtime ───────────────────────────────────────────────────────
FROM eclipse-temurin:21-jre-jammy
RUN groupadd -r vanguard && useradd -r -g vanguard vanguard
WORKDIR /app
COPY --from=builder /build/vanguard-pipeline/target/*.jar app.jar
USER vanguard
EXPOSE 8080 5150/udp
ENTRYPOINT ["java", "-jar", "app.jar"]
